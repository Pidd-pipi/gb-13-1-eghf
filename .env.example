# ===== 运行环境 =====
NODE_ENV=production

# ===== MySQL 数据库 =====
# root 管理员密码
MYSQL_ROOT_PASSWORD=root_password_123
# 平台使用的数据库名
MYSQL_DATABASE=campus_bookstore
# 平台使用的数据库账号
MYSQL_USER=campus_user
# 平台使用的数据库密码
MYSQL_PASSWORD=campus_password_123

# ===== Redis（会话/验证码缓存） =====
REDIS_PASSWORD=redis_password_123

# ===== MinIO（书籍图片对象存储） =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# MinIO 访问密钥（后端服务使用）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
# 存储桶名称
MINIO_BUCKET=books

# ===== JWT 认证 =====
# 生产环境务必修改为随机字符串
JWT_SECRET=please_change_this_secret_in_production
# Token 有效期
JWT_EXPIRES_IN=7d

# ===== SMTP 邮箱（发送注册验证码） =====
# 未配置真实 SMTP 时，验证码会打印在后端日志中（mock 方式）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@campus-bookstore.com
